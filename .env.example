# Copy to .env and replace every <placeholder>. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=merchant
DATABASE_PASSWORD=<choose-a-local-db-password>
DATABASE_NAME=merchant
# Used only by `npm run test:e2e` (created by docker/postgres/init.sql)
DATABASE_TEST_NAME=merchant_test

REDIS_HOST=localhost
REDIS_PORT=6380

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=1h

RISK_JOB_ATTEMPTS=3
RISK_JOB_BACKOFF_MS=2000

# Password given to every seeded demo user (development only)
SEED_USER_PASSWORD=<choose-a-demo-password>
